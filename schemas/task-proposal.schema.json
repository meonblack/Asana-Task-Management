{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elevate Task Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "title",
    "description",
    "source",
    "priority",
    "status",
    "review_required"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "meeting",
            "email",
            "calendar",
            "drive",
            "manual"
          ]
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "project_gid": {
      "type": [
        "string",
        "null"
      ]
    },
    "section_gid": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignee_gid": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "priority": {
      "enum": [
        "Low",
        "Normal",
        "High",
        "Urgent"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_required": {
      "const": true
    },
    "fingerprint": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "published",
        "publish_failed"
      ]
    },
    "uncertain_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}